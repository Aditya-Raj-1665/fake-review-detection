# Relative to the repository root; set a trained version after explicit training.
MODEL_PATH=artifacts/baseline/demo-v1
MODEL_TYPE=baseline
BACKEND_TARGET=runtime
WEB_CONCURRENCY=1
LOG_LEVEL=INFO
MAX_REVIEW_LENGTH=10000
MAX_BATCH_SIZE=32
MAX_REQUEST_BYTES=1048576
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Leave unset to use the threshold saved in the artifact.
# PREDICTION_THRESHOLD=0.5
